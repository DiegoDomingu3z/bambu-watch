# Printer, on your LAN. The access code is on the P1S screen under
# Settings > WLAN. Never commit the real .env.
BAMBU_HOST=192.168.1.123
BAMBU_SERIAL=01Pxxxxxxxxxxxx
BAMBU_ACCESS_CODE=xxxxxxxx

# Vision API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Discord webhook (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Optional tuning. Defaults shown; raise NORMAL_INTERVAL to cut API cost.
# VISION_MODEL=claude-sonnet-5
# VISION_EFFORT=low
# FRAME_UPLOAD_WIDTH=640
# NORMAL_INTERVAL=45
# SUSPICIOUS_INTERVAL=10
# SUSPICION_THRESHOLD=0.80
# CONFIRMATION_THRESHOLD=0.85
# ALERT_COOLDOWN_MINUTES=15

# Filament cost. Defaults are a 1kg spool at 13 USD, so 0.013 per gram.
# SPOOL_COST=13.0
# SPOOL_WEIGHT_G=1000

# Sliced-file fetch over FTPS, for weight, length and colours.
# Read-only, and never attempted while the printer is RUNNING.
# ENABLE_SLICE_FETCH=true
# BAMBU_FTP_PORT=990
# FTP_TIMEOUT_SECONDS=30
# FTP_MAX_FETCH_BYTES=33554432
# FTP_SEARCH_DIRS=/,/cache

# Print start and finish notifications. No API cost; webhook only.
# NOTIFY_ON_START=true
# NOTIFY_ON_FINISH=true

# Rates used only to display monitoring spend in the finish message.
# Update these if you change VISION_MODEL; defaults are claude-sonnet-5.
# VISION_INPUT_COST_PER_MTOK=2.0
# VISION_OUTPUT_COST_PER_MTOK=10.0

# Store a picture of how each print ended, for a dashboard. The path to the
# full-resolution frame is always recorded; this controls the downscaled copy
# kept in the database itself.
# STORE_FINAL_FRAME=true
# FINAL_FRAME_WIDTH=640
